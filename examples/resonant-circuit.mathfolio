      "input": "f := 360 kHz -> kHz",
      "note": false,
      "imported": null
    },
    {
      "input": "omega := 2*pi*f -> rad/s",
      "note": false,
      "imported": null
    },
    {
      "input": "L := 15 uH -> uH",
      "note": false,
      "imported": null
    },
    {
      "input": "C := 1/(omega^2*L) -> nF",
      "note": false,
      "imported": null
    },
    {
      "input": "R := 50 ohm -> ohm",
      "note": false,
      "imported": null
    },
    {
      "input": "Z := R + i*(omega*L - 1/(omega*C)) -> ohm",
      "note": false,
      "imported": null
    },
    {
      "input": "abs(Z) -> ohm",
      "note": false,
      "imported": null
    },
    {
      "input": "period := 1/f -> us",
      "note": false,
      "imported": null
    },
